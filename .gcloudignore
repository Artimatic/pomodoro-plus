.nx/polygraph/
*.db
*.db-shm
*.db-wal
.env
.env.local
.env.production
.vscode/
.DS_Store
Thumbs.db
/.angular
app.private.yaml
.gcloudignore
.git
.gitignore
node_modules/
dist/
npm-debug.log
.env