.nx/cache/
.nx/workspace-data/
.nx/tmp/
.nx/polygraph/
*.db
*.db-shm
*.db-wal

# Exclude environment and local configs
.env
.env.local
.env.production
.vscode/

# Exclude system files
.DS_Store
Thumbs.db
/.angular

app.private.yaml
.angular
